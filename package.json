{
  "name": "snk-b-backend",
  "version": "1.0.0",
  "description": "Snooker hall backend - Tables, Sessions, Orders, Shifts",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js",
    "db:migrate": "node src/db/migrations/001_product_category_unit_stock.js",
    "db:migrate:image": "node src/db/migrations/002_product_image_url.js",
    "db:migrate:branches": "node src/db/migrations/009_branches.js",
    "db:migrate:stores": "node src/db/migrations/013_stores.js",
    "db:migrate:tables-price": "node src/db/migrations/016_tables_price_per_unit.js",
    "db:migrate:tables-pricing": "node src/db/migrations/017_tables_pricing.js",
    "db:migrate:transactions": "node src/db/migrations/018_transactions.js",
    "db:migrate:incomes-expenses": "node src/db/migrations/019_incomes_expenses_split.js",
    "db:migrate:unit-cost": "node src/db/migrations/025_order_items_unit_cost.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5"
